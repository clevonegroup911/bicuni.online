{
  "name": "bicuni-online",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed:plans": "node scripts/seed-plans.mjs",
    "admin:init": "tsx scripts/init-super-admin.ts",
    "search:configure": "tsx scripts/configure-search.ts",
    "search:outbox": "prisma db execute --file scripts/search-outbox.sql --schema prisma/schema.prisma",
    "search:reindex": "tsx scripts/reindex-search.ts",
    "search:worker": "tsx scripts/search-worker.ts",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:baseline": "bash scripts/baseline-existing-db.sh",
    "db:baseline:execute": "bash scripts/baseline-existing-db.sh --execute"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@google-cloud/storage": "^7.21.0",
    "@next/swc-linux-x64-gnu": "16.3.1",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "framer-motion": "12.4.10",
    "lucide-react": "^0.468.0",
    "meilisearch": "0.60.0",
    "motion-dom": "12.4.10",
    "motion-utils": "12.4.10",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^5.12.1",
    "stripe": "17.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.5",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "uuid": "11.1.1"
  }
}
