# Required by Prisma and every server process.
DATABASE_URL="postgresql://bicuni:change-me@localhost:5432/bicuni"
# Required by Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Canonical public HTTPS origin used in email links and Stripe return URLs.
PUBLIC_APP_URL="http://localhost:3000"
# One-time bootstrap only. Remove SUPER_ADMIN_PASSWORD after `npm run admin:init`.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_NAME=""
SUPER_ADMIN_PASSWORD=""
# Required for transactional email in production.
RESEND_API_KEY=""
EMAIL_FROM="BICUNI <noreply@bicuni.online>"
# Optional override for isolated QA only. Production defaults to the Resend HTTPS API.
RESEND_API_URL=""
# Required only by Stripe checkout/webhooks. Use sk_test_... locally.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Required only by private document upload/download.
GOOGLE_CLOUD_PROJECT=""
GCS_BUCKET=""
DOCUMENT_MAX_UPLOAD_BYTES="52428800"
NEXT_PUBLIC_DOCUMENT_MAX_UPLOAD_BYTES="52428800"
# Optional AI providers; never exposed to the browser.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
# Required for indexed search; Redis is optional for search fallback, required for production rate limiting.
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_MASTER_KEY=""
MEILISEARCH_SEARCH_KEY=""
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="bicuni-local"
REDIS_CONNECT_TIMEOUT_MS="750"
REDIS_COMMAND_TIMEOUT_MS="500"
# loopback locally. Cloud Run sets K_SERVICE and defaults to cloud-run (last X-Forwarded-For hop).
TRUSTED_PROXY_STRATEGY="loopback"
# Optional HTTPS scanner. Unset keeps files PENDING; never treated as clean.
ANTIVIRUS_SCANNER_URL=""
ANTIVIRUS_SCANNER_TIMEOUT_MS="4000"
SEARCH_SYNC_SECRET="replace-with-a-long-random-secret"
SEARCH_WORKER_BATCH_SIZE="100"
# BICUNI Persistent Identifier (internal only — not a registered DOI). Public resolver: /pid/{prefix}/{suffix}
# BICUNI_PID_SCHEME must be BICUNI_PID (or unset). DOI is rejected fail-closed; no env flag enables local DOI generation.
# BICUNI_PID_PREFIX must be bcu (or unset). 10.x / 10.bcu prefixes are rejected.
APP_URL="https://bicuni.online"
# Optional HTTPS origin when private objects are served through a dedicated CDN.
GCS_PUBLIC_ORIGIN=""
BICUNI_PID_PREFIX="bcu"
BICUNI_PID_SCHEME="BICUNI_PID"
# Optional comma-separated extra HTTPS hosts for PID target URLs. bicuni.online is always allowed.
BICUNI_PID_ALLOWED_HOSTS=""
