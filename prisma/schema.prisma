generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MODERATOR
  INSTITUTION_ADMIN
  STUDENT
  RESEARCHER
  UNIVERSITY_ADMIN
  SUPER_ADMIN
  GOVERNMENT
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum DocumentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
  DELETED
}

enum DocumentType {
  TFC
  MEMOIRE
  THESE
  ARTICLE
  RAPPORT
}

enum FileScanStatus {
  PENDING
  SCANNING
  CLEAN
  REJECTED
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  MPESA
  AIRTEL_MONEY
  ORANGE_MONEY
  RAWBANK
}

enum InstitutionType {
  UNIVERSITY
  HIGHER_INSTITUTE
  RESEARCH_CENTER
  SCHOOL
  OTHER
}

enum InstitutionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?
  name                String?
  role                Role                 @default(USER)
  status              UserStatus           @default(PENDING)
  emailVerified       DateTime?
  lastLoginAt         DateTime?
  image               String?
  stripeCustomerId    String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  profile             Profile?
  accounts            Account[]
  sessions            Session[]
  subscriptions       Subscription[]
  payments            Payment[]
  documents           Document[]
  reviews             Review[]
  publications        Publication[]
  searchLogs          SearchLog[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  universityAdmins    University[]         @relation("UniversityAdmins")
  passwordResetTokens PasswordResetToken[]
  favorites           DocumentFavorite[]
  comments            DocumentComment[]
  documentEvents      DocumentHistory[]
  persistentIdentifiers PersistentIdentifier[] @relation("PidCreator")
  pidTargetChanges      PersistentIdentifierTargetHistory[] @relation("PidChanger")
  mfaEnabled            Boolean              @default(false)
  mfaSecretEnc          String?
  mfaEnrolledAt         DateTime?
  mfaRecoveryHashes     String[]             @default([])
  mfaFailedAttempts     Int                  @default(0)
  mfaLockedUntil        DateTime?
  mfaLastVerifiedAt     DateTime?
  paymentOrders         PaymentOrder[]
  paymentIntents        PaymentIntent[]
  reconciliationDecisions ReconciliationDecision[]
  paymentNotifications  PaymentNotification[]
  paymentRefundsRequested PaymentRefund[] @relation("RefundRequester")
  paymentRefundsReviewed  PaymentRefund[] @relation("RefundReviewer")
  fxRatesEntered        FxRate[]             @relation("FxEnteredBy")
  fxRatesApproved       FxRate[]             @relation("FxApprovedBy")
  outcomeMissionsOwned  OutcomeMission[]     @relation("OutcomeMissionOwner")
  outcomeApprovals      OutcomeApproval[]    @relation("OutcomeApprovalActor")
  outcomeAcceptances    OutcomeAcceptance[]  @relation("OutcomeAcceptanceActor")
  outcomeRevisions      OutcomeRevision[]    @relation("OutcomeRevisionRequester")
  outcomeAgentJournal   OutcomeAgentJournal[]

  @@index([role, status, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expires])
}

model Profile {
  id             String      @id @default(cuid())
  userId         String      @unique
  bio            String?
  title          String?
  orcid          String?     @unique
  country        String?
  researchFields String[]
  website        String?
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId   String?
  university     University? @relation(fields: [universityId], references: [id])
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
}

model Plan {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  priceCents      Int
  currency        String         @default("USD")
  interval        String         @default("month")
  features        Json
  active          Boolean        @default(true)
  providerPriceId String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
  paymentOrders   PaymentOrder[]
  paymentIntents  PaymentIntent[]
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  planId            String
  provider          PaymentProvider    @default(STRIPE)
  providerRef       String?            @unique
  status            SubscriptionStatus @default(INCOMPLETE)
  startedAt         DateTime?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              Plan               @relation(fields: [planId], references: [id])
  payments          Payment[]
  invoices          Invoice[]

  @@index([userId, status, currentPeriodEnd])
}

model Payment {
  id               String           @id @default(cuid())
  userId           String
  subscriptionId   String?
  outcomeMissionId String?
  provider         PaymentProvider
  providerRef      String           @unique
  amountCents      Int
  currency         String           @default("USD")
  status           String
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id])
  subscription     Subscription?    @relation(fields: [subscriptionId], references: [id])
  outcomeMission   OutcomeMission?  @relation(fields: [outcomeMissionId], references: [id], onDelete: SetNull)

  @@index([outcomeMissionId])
}

model Invoice {
  id                String           @id @default(cuid())
  subscriptionId    String?
  outcomeMissionId  String?
  provider          PaymentProvider
  providerRef       String           @unique
  number            String?
  amountDueCents    Int
  amountPaidCents   Int              @default(0)
  currency          String           @default("USD")
  status            String
  hostedUrl         String?
  pdfUrl            String?
  periodStart       DateTime?
  periodEnd         DateTime?
  fxPair            String?
  fxRateUnits       Int?
  fxSource          String?
  fxEffectiveAt     DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  subscription      Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  outcomeMission    OutcomeMission?  @relation(fields: [outcomeMissionId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, createdAt])
  @@index([outcomeMissionId, createdAt])
}

model WebhookEvent {
  id              String          @id @default(cuid())
  provider        PaymentProvider
  providerEventId String
  eventType       String
  processedAt     DateTime        @default(now())

  @@unique([provider, providerEventId])
}

model University {
  id        String            @id @default(cuid())
  name      String
  acronym   String?
  slug      String            @unique
  type      InstitutionType   @default(UNIVERSITY)
  country   String
  province  String?
  city      String?
  address   String?
  website   String?
  domain    String?
  logoUrl   String?
  status    InstitutionStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  faculties Faculty[]
  profiles  Profile[]
  documents Document[]
  admins    User[]            @relation("UniversityAdmins")
  outcomeMissions OutcomeMission[]

  @@index([status, type, country])
  @@index([createdAt])
}

model Faculty {
  id           String       @id @default(cuid())
  name         String
  universityId String
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departments  Department[]
  documents    Document[]

  @@unique([universityId, name])
}

model Department {
  id        String     @id @default(cuid())
  name      String
  facultyId String
  faculty   Faculty    @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  profiles  Profile[]
  documents Document[]

  @@unique([facultyId, name])
}

model Document {
  id                 String             @id @default(cuid())
  slug               String             @unique
  title              String
  abstract           String?
  language           String             @default("fr")
  type               DocumentType       @default(ARTICLE)
  license            String             @default("Tous droits réservés")
  promotion          String?
  academicYear       String             @default("Non renseignée")
  year               Int?
  status             DocumentStatus     @default(DRAFT)
  authorId           String
  universityId       String?
  facultyId          String?
  departmentId       String?
  categoryId         String
  metadata           Json?
  viewCount          Int                @default(0)
  downloadCount      Int                @default(0)
  favoriteCount      Int                @default(0)
  commentCount       Int                @default(0)
  currentVersion     Int                @default(1)
  thumbnailObjectKey String?
  publishedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  author             User               @relation(fields: [authorId], references: [id])
  university         University?        @relation(fields: [universityId], references: [id])
  faculty            Faculty?           @relation(fields: [facultyId], references: [id])
  department         Department?        @relation(fields: [departmentId], references: [id])
  category           Category           @relation(fields: [categoryId], references: [id])
  files              DocumentFile[]
  tags               Tag[]              @relation("DocumentTags")
  reviews            Review[]
  publication        Publication?
  aiSummary          AiSummary?
  certificates       Certificate[]
  favorites          DocumentFavorite[]
  comments           DocumentComment[]
  history            DocumentHistory[]
  outcomeSources     OutcomeMissionSource[]

  @@index([status, createdAt])
  @@index([categoryId, year])
  @@index([authorId, status, updatedAt])
  @@index([universityId, facultyId, departmentId])
}

model DocumentFile {
  id         String         @id @default(cuid())
  documentId String
  objectKey  String         @unique
  fileName   String
  mimeType   String
  sizeBytes  Int
  checksum   String
  version    Int            @default(1)
  isUploaded Boolean        @default(false)
  scanStatus FileScanStatus @default(PENDING)
  scannedAt  DateTime?
  createdAt  DateTime       @default(now())
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, scanStatus])
}

model DocumentFavorite {
  userId     String
  documentId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([userId, documentId])
  @@index([documentId])
}

model DocumentComment {
  id         String    @id @default(cuid())
  documentId String
  authorId   String
  body       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
}

model DocumentHistory {
  id         String          @id @default(cuid())
  documentId String
  actorId    String?
  action     String
  fromStatus DocumentStatus?
  toStatus   DocumentStatus?
  version    Int
  comment    String?
  metadata   Json?
  createdAt  DateTime        @default(now())
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor      User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  documents Document[]
}

model Tag {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  documents Document[] @relation("DocumentTags")
}

model Publication {
  id          String   @id @default(cuid())
  documentId  String   @unique
  publisherId String
  internalDoi String?  @unique
  publishedAt DateTime @default(now())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  publisher   User     @relation(fields: [publisherId], references: [id])
}

model Review {
  id         String         @id @default(cuid())
  documentId String
  reviewerId String
  decision   DocumentStatus
  comment    String?
  createdAt  DateTime       @default(now())
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewer   User           @relation(fields: [reviewerId], references: [id])
}

model Certificate {
  id         String   @id @default(cuid())
  documentId String
  code       String   @unique
  type       String
  issuedAt   DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model AiSummary {
  id         String   @id @default(cuid())
  documentId String   @unique
  summary    String
  keywords   String[]
  model      String
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model SearchLog {
  id          String   @id @default(cuid())
  userId      String?
  query       String
  filters     Json?
  resultCount Int
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model SearchIndexJob {
  id          String    @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([processedAt, availableAt, createdAt])
  @@index([entityType, entityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  ipHash     String?
  userAgent  String?
  oldValue   Json?
  newValue   Json?
  payload    Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

enum PaymentChannel {
  MPESA
  RAWBANK_CDF
  RAWBANK_USD
}

enum PaymentIntentStatus {
  AWAITING_PAYMENT
  PROOF_SUBMITTED
  MATCHING
  PENDING
  REVIEW_REQUIRED
  PAID
  REJECTED
  EXPIRED
  REFUNDED
}

enum PaymentMatchClass {
  STRONG
  INCOMPLETE
  VARIANCE
  REJECT
}

enum PaymentRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ReconciliationAction {
  PROPOSE_PAID
  CONFIRM_PAID
  REJECT
  CORRECT
  EXPIRE
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationDeliveryStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED_UNCONFIGURED
}

enum PaymentRefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

enum FxRateStatus {
  PENDING_APPROVAL
  ACTIVE
  SUPERSEDED
  REJECTED
}

model FxRate {
  id           String       @id @default(cuid())
  pair         String       @default("USD_CDF")
  rateUnits    Int
  source       String
  effectiveAt  DateTime
  expiresAt    DateTime?
  enteredById  String
  approvedById String?
  approvedAt   DateTime?
  status       FxRateStatus @default(PENDING_APPROVAL)
  createdAt    DateTime     @default(now())
  enteredBy    User         @relation("FxEnteredBy", fields: [enteredById], references: [id])
  approvedBy   User?        @relation("FxApprovedBy", fields: [approvedById], references: [id])
  orders       PaymentOrder[]
  intents      PaymentIntent[]

  @@index([pair, status, effectiveAt])
  @@index([pair, approvedAt])
}

model PaymentOrder {
  id               String           @id @default(cuid())
  userId           String
  planId           String
  outcomeMissionId String?
  amountCents      Int
  currency         String
  status           String           @default("OPEN")
  fxPair           String?
  fxRateUnits      Int?
  fxSource         String?
  fxEffectiveAt    DateTime?
  fxRateId         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             Plan             @relation(fields: [planId], references: [id])
  outcomeMission   OutcomeMission?  @relation(fields: [outcomeMissionId], references: [id], onDelete: SetNull)
  fxRate           FxRate?          @relation(fields: [fxRateId], references: [id], onDelete: SetNull)
  intents          PaymentIntent[]

  @@index([userId, createdAt])
  @@index([outcomeMissionId])
}

model PaymentIntent {
  id                   String                    @id @default(cuid())
  publicRef            String                    @unique
  userId               String
  orderId              String
  planId               String
  subscriptionId       String?
  outcomeMissionId     String?
  invoiceId            String?                   @unique
  channel              PaymentChannel
  amountCents          Int
  currency             String
  destinationAccount   String
  fxPair               String?
  fxRateUnits          Int?
  fxSource             String?
  fxEffectiveAt        DateTime?
  fxRateId             String?
  status               PaymentIntentStatus       @default(AWAITING_PAYMENT)
  matchClass           PaymentMatchClass?
  riskLevel            PaymentRiskLevel          @default(MEDIUM)
  expiresAt            DateTime
  paidAt               DateTime?
  proposedPaidById     String?
  proposedPaidAt       DateTime?
  providerTxnRef       String?                   @unique
  idempotencyKey       String                    @unique
  activatedAt          DateTime?
  retentionUntil       DateTime
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order                PaymentOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  plan                 Plan                      @relation(fields: [planId], references: [id])
  outcomeMission       OutcomeMission?           @relation(fields: [outcomeMissionId], references: [id], onDelete: SetNull)
  fxRate               FxRate?                   @relation(fields: [fxRateId], references: [id], onDelete: SetNull)
  attempts             PaymentAttempt[]
  proofs               PaymentProof[]
  decisions            ReconciliationDecision[]
  transitions          PaymentStateTransition[]
  providerTransactions ProviderTransaction[]
  receipt              PaymentReceipt?
  refunds              PaymentRefund[]
  notifications        PaymentNotification[]

  @@index([userId, status, createdAt])
  @@index([status, channel, currency, createdAt])
  @@index([expiresAt, status])
  @@index([outcomeMissionId])
}

model PaymentAttempt {
  id                 String          @id @default(cuid())
  intentId           String
  channel            PaymentChannel
  amountCents        Int
  currency           String
  payerName          String
  payerPhone         String
  providerTxnRef     String
  paidAtClient       DateTime
  destinationAccount String
  createdAt          DateTime        @default(now())
  intent             PaymentIntent   @relation(fields: [intentId], references: [id], onDelete: Cascade)
  proofs             PaymentProof[]

  @@index([intentId, createdAt])
}

model PaymentProof {
  id         String         @id @default(cuid())
  intentId   String
  attemptId  String
  objectKey  String
  fileName   String
  mimeType   String
  sizeBytes  Int
  checksum   String         @default("")
  scanStatus FileScanStatus @default(PENDING)
  isUploaded Boolean        @default(false)
  scannedAt  DateTime?
  createdAt  DateTime       @default(now())
  intent     PaymentIntent  @relation(fields: [intentId], references: [id], onDelete: Cascade)
  attempt    PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([intentId, scanStatus])
}

model ProviderTransaction {
  id             String         @id @default(cuid())
  intentId       String?
  channel        PaymentChannel
  providerTxnRef String         @unique
  amountCents    Int
  currency       String
  counterparty   String?
  occurredAt     DateTime
  source         String
  createdAt      DateTime       @default(now())
  intent         PaymentIntent? @relation(fields: [intentId], references: [id], onDelete: SetNull)

  @@index([channel, occurredAt])
}

model ReconciliationDecision {
  id            String               @id @default(cuid())
  intentId      String
  actorId       String
  action        ReconciliationAction
  fromStatus    PaymentIntentStatus
  toStatus      PaymentIntentStatus
  reason        String
  matchClass    PaymentMatchClass?
  riskLevel     PaymentRiskLevel?
  matchSnapshot Json?
  ipHash        String?
  userAgent     String?
  createdAt     DateTime             @default(now())
  intent        PaymentIntent        @relation(fields: [intentId], references: [id], onDelete: Cascade)
  actor         User                 @relation(fields: [actorId], references: [id])

  @@index([intentId, createdAt])
}

model PaymentStateTransition {
  id         String              @id @default(cuid())
  intentId   String
  fromStatus PaymentIntentStatus
  toStatus   PaymentIntentStatus
  reason     String
  actorId    String?
  metadata   Json?
  createdAt  DateTime            @default(now())
  intent     PaymentIntent       @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([intentId, createdAt])
}

model PaymentReceipt {
  id           String         @id @default(cuid())
  publicNumber String         @unique
  intentId     String         @unique
  invoiceId    String
  amountCents  Int
  currency     String
  channel      PaymentChannel
  confirmedAt  DateTime
  fingerprint  String
  createdAt    DateTime       @default(now())
  intent       PaymentIntent  @relation(fields: [intentId], references: [id], onDelete: Restrict)
}

model PaymentRefund {
  id             String              @id @default(cuid())
  intentId       String
  amountCents    Int
  currency       String
  reason         String
  status         PaymentRefundStatus @default(REQUESTED)
  requestedById  String
  reviewedById   String?
  reviewedAt     DateTime?
  processedAt    DateTime?
  idempotencyKey String              @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  intent         PaymentIntent       @relation(fields: [intentId], references: [id], onDelete: Restrict)
  requestedBy    User                @relation("RefundRequester", fields: [requestedById], references: [id])
  reviewedBy     User?               @relation("RefundReviewer", fields: [reviewedById], references: [id])

  @@index([intentId, status])
}

model PaymentNotification {
  id                String                     @id @default(cuid())
  intentId          String
  userId            String
  channel           NotificationChannel
  template          String
  status            NotificationDeliveryStatus
  providerMessageId String?
  error             String?
  createdAt         DateTime                   @default(now())
  intent            PaymentIntent              @relation(fields: [intentId], references: [id], onDelete: Cascade)
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([intentId, createdAt])
}

enum PersistentIdentifierScheme {
  BICUNI_PID
}

enum PersistentIdentifierStatus {
  ACTIVE
  DEPRECATED
  TOMBSTONE
}

enum PidResourceType {
  DOCUMENT
  PUBLICATION
}

model PersistentIdentifier {
  id           String                      @id @default(cuid())
  scheme       PersistentIdentifierScheme  @default(BICUNI_PID)
  prefix       String
  suffix       String
  identifier   String                      @unique
  resourceType PidResourceType
  resourceId   String
  targetUrl    String
  status       PersistentIdentifierStatus  @default(ACTIVE)
  metadata     Json?
  createdById  String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  createdBy    User?                       @relation("PidCreator", fields: [createdById], references: [id], onDelete: SetNull)
  history      PersistentIdentifierTargetHistory[]

  @@unique([prefix, suffix])
  @@unique([resourceType, resourceId])
  @@index([status, createdAt])
  @@index([resourceId])
}

model PersistentIdentifierTargetHistory {
  id                     String               @id @default(cuid())
  persistentIdentifierId String
  previousTargetUrl      String
  newTargetUrl           String
  changedById            String?
  changedAt              DateTime             @default(now())
  reason                 String?
  persistentIdentifier   PersistentIdentifier @relation(fields: [persistentIdentifierId], references: [id], onDelete: Restrict)
  changedBy              User?                @relation("PidChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([persistentIdentifierId, changedAt])
}

// ---------------------------------------------------------------------------
// OaaS — Outcome-as-a-Service (missions agentiques)
// ---------------------------------------------------------------------------

enum OutcomeMissionStatus {
  DRAFT
  QUALIFICATION_REQUIRED
  QUALIFIED
  QUOTED
  AWAITING_APPROVAL
  AWAITING_PAYMENT
  PLANNED
  READY
  EXECUTING
  AWAITING_HUMAN_REVIEW
  VERIFYING
  DELIVERY_READY
  DELIVERED
  ACCEPTED
  REVISION_REQUESTED
  COMPLETED
  BLOCKED
  FAILED
  CANCELLED
  EXPIRED
}

enum OutcomeContractStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REFUSED
  AMENDMENT_REQUESTED
  SUPERSEDED
}

enum OutcomeTaskStatus {
  PENDING
  READY
  RUNNING
  AWAITING_HUMAN
  COMPLETED
  FAILED
  SKIPPED
  BLOCKED
}

enum OutcomeApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum OutcomeDeliverableStatus {
  DRAFT
  READY
  DELIVERED
  ACCEPTED
  REJECTED
}

enum OutcomeEvidenceKind {
  SOURCE
  PROVENANCE
  CHECKSUM
  HUMAN_REVIEW
  QUALITY_GATE
  PAYMENT
  SYSTEM
}

enum OutcomeQualityVerdict {
  PASS
  FAIL
  WARN
  PENDING
}

enum OutcomeAcceptanceDecision {
  ACCEPTED
  REVISION_REQUESTED
  REJECTED
}

enum OutcomeCostKind {
  DEPOSIT
  MILESTONE
  BALANCE
  OUT_OF_SCOPE
  INSTITUTIONAL
}

enum OutcomeConfidentiality {
  STANDARD
  RESTRICTED
  CONFIDENTIAL
  STRICT
}

enum OutcomePricingMode {
  FIXED
  QUOTE
}

model OutcomePack {
  id                    String              @id @default(cuid())
  slug                  String              @unique
  title                 String
  summary               String
  resultDescription     String
  requiredInputs        Json
  indicativeDeadlineDays Int
  revisionsIncluded     Int                 @default(1)
  acceptanceCriteria    Json
  confidentialityDefault OutcomeConfidentiality @default(STANDARD)
  pricingMode           OutcomePricingMode  @default(QUOTE)
  indicativePriceCents  Int?
  currency              String              @default("USD")
  planSlug              String?
  active                Boolean             @default(true)
  sortOrder             Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  missions              OutcomeMission[]

  @@index([active, sortOrder])
}

model OutcomeMission {
  id                    String                @id @default(cuid())
  publicRef             String                @unique
  ownerId               String
  universityId          String?
  packId                String?
  title                 String
  originalRequest       String
  expectedOutcome       String
  language              String                @default("fr")
  academicDomain        String?
  academicLevel         String?
  scope                 String?
  exclusions            String?
  deadlineAt            DateTime?
  maxBudgetCents        Int?
  confidentiality       OutcomeConfidentiality @default(STANDARD)
  acceptanceCriteria    Json?
  status                OutcomeMissionStatus  @default(DRAFT)
  estimatedCostCents    Int?
  actualCostCents       Int                   @default(0)
  currency              String                @default("USD")
  risks                 Json?
  integrityDeclaration  String?
  aiAssistanceLevel     String?
  nextStep              String?
  blockedReason         String?
  quotedAt              DateTime?
  approvedAt            DateTime?
  paidAt                DateTime?
  startedAt             DateTime?
  deliveredAt           DateTime?
  acceptedAt            DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  owner                 User                  @relation("OutcomeMissionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  university            University?           @relation(fields: [universityId], references: [id], onDelete: SetNull)
  pack                  OutcomePack?          @relation(fields: [packId], references: [id], onDelete: SetNull)
  sources               OutcomeMissionSource[]
  contract              OutcomeContract?
  plan                  OutcomePlan?
  tasks                 OutcomeTask[]
  agentAssignments      OutcomeAgentAssignment[]
  approvals             OutcomeApproval[]
  evidences             OutcomeEvidence[]
  deliverables          OutcomeDeliverable[]
  qualityChecks         OutcomeQualityCheck[]
  revisions             OutcomeRevision[]
  acceptance            OutcomeAcceptance?
  costs                 OutcomeCost[]
  milestones            OutcomeMilestone[]
  statusTransitions     OutcomeStatusTransition[]
  paymentOrders         PaymentOrder[]
  paymentIntents        PaymentIntent[]
  invoices              Invoice[]
  payments              Payment[]

  @@index([ownerId, status, createdAt])
  @@index([status, updatedAt])
  @@index([packId])
}

model OutcomeMissionSource {
  id          String         @id @default(cuid())
  missionId   String
  documentId  String?
  label       String
  uri         String?
  notes       String?
  accessible  Boolean        @default(true)
  createdAt   DateTime       @default(now())
  mission     OutcomeMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  document    Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([missionId])
}

model OutcomeContract {
  id                      String                @id @default(cuid())
  missionId               String                @unique
  version                 Int                   @default(1)
  status                  OutcomeContractStatus @default(DRAFT)
  objective               String
  deliverables            Json
  sourcesProvided         Json
  externalSourcesAllowed  Json
  acceptanceCriteria      Json
  deadlineAt              DateTime?
  priceCents              Int
  depositCents            Int                   @default(0)
  balanceCents            Int                   @default(0)
  currency                String                @default("USD")
  revisionsIncluded       Int                   @default(1)
  limits                  String?
  confidentiality         OutcomeConfidentiality @default(STANDARD)
  authorizations          Json?
  humanValidationActions  Json?
  cancellationTerms       String?
  refundTerms             String?
  integrityWarnings       Json?
  issuedAt                DateTime?
  acceptedAt              DateTime?
  refusedAt               DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  mission                 OutcomeMission        @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model OutcomePlan {
  id            String         @id @default(cuid())
  missionId     String         @unique
  version       Int            @default(1)
  graph         Json
  checkpoint    Json?
  resumeToken   String?
  estimatedMinutes Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  mission       OutcomeMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model OutcomeTask {
  id              String            @id @default(cuid())
  missionId       String
  key             String
  title           String
  description     String?
  status          OutcomeTaskStatus @default(PENDING)
  dependsOn       String[]          @default([])
  agentKey        String?
  parallelGroup   String?
  requiresHuman   Boolean           @default(false)
  costCents       Int               @default(0)
  result          Json?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  mission         OutcomeMission    @relation(fields: [missionId], references: [id], onDelete: Cascade)
  assignments     OutcomeAgentAssignment[]

  @@unique([missionId, key])
  @@index([missionId, status])
}

model OutcomeAgent {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  specialty       String
  version         String   @default("1.0.0")
  tools           Json
  permissions     Json
  allowedSources  Json
  costPerTaskCents Int     @default(0)
  available       Boolean  @default(true)
  successRateBps  Int      @default(0)
  confidenceLevel String   @default("medium")
  lastActiveAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  assignments     OutcomeAgentAssignment[]
  journal         OutcomeAgentJournal[]
}

model OutcomeAgentAssignment {
  id        String         @id @default(cuid())
  missionId String
  taskId    String
  agentId   String
  role      String         @default("executor")
  assignedAt DateTime      @default(now())
  mission   OutcomeMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  task      OutcomeTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent     OutcomeAgent   @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@unique([taskId, agentId])
  @@index([missionId])
}

model OutcomeAgentJournal {
  id        String       @id @default(cuid())
  agentId   String
  missionId String?
  actorId   String?
  event     String
  detail    Json?
  createdAt DateTime     @default(now())
  agent     OutcomeAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  actor     User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([agentId, createdAt])
}

model OutcomeApproval {
  id          String                @id @default(cuid())
  missionId   String
  actorId     String?
  kind        String
  title       String
  status      OutcomeApprovalStatus @default(PENDING)
  reason      String?
  decidedAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  mission     OutcomeMission        @relation(fields: [missionId], references: [id], onDelete: Cascade)
  actor       User?                 @relation("OutcomeApprovalActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([missionId, status])
}

model OutcomeEvidence {
  id          String              @id @default(cuid())
  missionId   String
  kind        OutcomeEvidenceKind
  title       String
  summary     String?
  payload     Json
  checksum    String?
  invented    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  mission     OutcomeMission      @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, kind])
}

model OutcomeDeliverable {
  id            String                   @id @default(cuid())
  missionId     String
  key           String
  title         String
  format        String
  status        OutcomeDeliverableStatus @default(DRAFT)
  content       Json?
  objectKey     String?
  checksum      String?
  deliveredAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  mission       OutcomeMission           @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, key])
  @@index([missionId, status])
}

model OutcomeQualityCheck {
  id          String                @id @default(cuid())
  missionId   String
  key         String
  title       String
  verdict     OutcomeQualityVerdict @default(PENDING)
  details     Json?
  checkedAt   DateTime?
  createdAt   DateTime              @default(now())
  mission     OutcomeMission        @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, key])
  @@index([missionId, verdict])
}

model OutcomeRevision {
  id          String         @id @default(cuid())
  missionId   String
  requesterId String
  reason      String
  scope       String?
  status      String         @default("OPEN")
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?
  mission     OutcomeMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  requester   User           @relation("OutcomeRevisionRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([missionId, status])
}

model OutcomeAcceptance {
  id          String                     @id @default(cuid())
  missionId   String                     @unique
  actorId     String
  decision    OutcomeAcceptanceDecision
  comment     String?
  decidedAt   DateTime                   @default(now())
  mission     OutcomeMission             @relation(fields: [missionId], references: [id], onDelete: Cascade)
  actor       User                       @relation("OutcomeAcceptanceActor", fields: [actorId], references: [id], onDelete: Cascade)
}

model OutcomeCost {
  id          String          @id @default(cuid())
  missionId   String
  kind        OutcomeCostKind
  label       String
  amountCents Int
  currency    String          @default("USD")
  invoiceId   String?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  mission     OutcomeMission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, kind])
}

model OutcomeMilestone {
  id          String         @id @default(cuid())
  missionId   String
  key         String
  title       String
  amountCents Int            @default(0)
  unlockedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  mission     OutcomeMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, key])
}

model OutcomeStatusTransition {
  id          String               @id @default(cuid())
  missionId   String
  fromStatus  OutcomeMissionStatus
  toStatus    OutcomeMissionStatus
  reason      String?
  actorId     String?
  createdAt   DateTime             @default(now())
  mission     OutcomeMission       @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, createdAt])
}
